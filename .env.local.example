# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Books API — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_BOOKS_API_KEY=your-google-api-key

# Seed script only — Supabase → Authentication → Users → copy your test user UUID
SEED_USER_ID=your-test-user-uuid

# Cloudflare Turnstile — site key (public) of the widget whose secret is set in
# Supabase → Authentication → Attack Protection. Leave empty locally if CAPTCHA
# protection is off. Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
